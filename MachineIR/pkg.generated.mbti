pub fn Module::to_string(Self) -> String
pub fn Module::translate_global_values(Self, @IR.Module) -> Unit raise MIRError
pub fn Module::translate_llvm_global_constant(Self, String, &@IR.Constant) -> Unit raise MIRError
pub fn Module::translate_llvm_module(Self, @IR.Module) -> Unit raise MIRError
pub impl Show for Module

pub(all) enum OpCode {
  IBinary(IBinaryOpCode, Int32)
  IUnary(IUnaryOpCode, Int32)
  ICmp(ICmpOpCode, Int32)
  ILoad(Int32)
  IStore(Int32)
  IMove(Int32)
  Branch(BranchOpCode, Int32)
  FBinary(FBinaryOpCode, Int32)
  FUnary(FUnaryOpCode, Int32)
  FCmp(FCmpOpCode, Int32)
  FLoad(Int32)
  FStore(Int32)
  FMove(Int32)
  FMoveI(Int32)
  IMoveF(Int32)
  LoadAddr
  Cast(CastOpCode)
  Call
  Select
  Ret
  Nop
  Intrinsic(String)
} derive(Eq)
pub fn OpCode::equal(Self, Self) -> Bool
pub fn OpCode::is_terminator(Self) -> Bool
pub fn OpCode::not_equal(Self, Self) -> Bool
pub fn OpCode::output(Self, &Logger) -> Unit
pub fn OpCode::to_string(Self) -> String
pub impl Show for OpCode

pub(all) enum Operand {
  IRegister(IRegister)
  FRegister(FRegister)
  Mem(IRegister, Int64)
  MemLoc(IRegister, Int64)
  MemGroup(IRegister, Array[Int64])
  Imm(Int64)
  FImm(Double)
  Label(String)
} derive(Eq, Hash)
pub fn Operand::equal(Self, Self) -> Bool
pub fn Operand::hash(Self) -> Int32
pub fn Operand::hash_combine(Self, Hasher) -> Unit
pub fn Operand::not_equal(Self, Self) -> Bool
pub fn Operand::output(Self, &Logger) -> Unit
pub fn Operand::to_string(Self) -> String
pub impl Show for Operand

