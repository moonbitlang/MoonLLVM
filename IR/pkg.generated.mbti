}

pub trait User : Value {
  fn asUserEnum(Self) -> UserEnum
  fn getUserBase(Self) -> UserBase
  fn getOperands(Self) -> Array[&Value]
  fn getOperand(Self, Int32) -> &Value?
  fn getNumOperands(Self) -> Int32
}
