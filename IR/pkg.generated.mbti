pub fn &User::not_equal(Self, Self) -> Bool
pub impl Eq for &User

pub trait Value : Show {
  fn getValueBase(Self) -> ValueBase
  fn asValueEnum(Self) -> ValueEnum
  fn getType(Self) -> &Type
  fn getContext(Self) -> Context
  fn addUser(Self, &User) -> Unit
  fn getValueRepr(Self) -> String
  fn getName(Self) -> String?
  fn setName(Self, String) -> Unit raise LLVMValueError
  fn removeName(Self) -> Unit raise LLVMValueError
  fn getNameOrSlot(Self) -> @either.Either[String, UInt64]?
  fn getNameOrSlotStr(Self) -> String
  fn replaceAllUsersWith(Self, &Value) -> Unit
  fn getUsers(Self) -> Array[&User]?
  fn user_empty(Self) -> Bool
  fn tryAsConstant(Self) -> &Constant?
  fn tryAsConstantEnum(Self) -> ConstantEnum?
  fn tryAsUser(Self) -> &User?
  fn tryAsUserEnum(Self) -> UserEnum?
  fn tryAsInst(Self) -> &Instruction?
  fn tryAsInstEnum(Self) -> InstEnum?
  fn tryAsGlobalValue(Self) -> &GlobalValue?
  fn tryAsGlobalValueEnum(Self) -> GlobalValueEnum?
}
pub fn &Value::equal(Self, Self) -> Bool
pub fn &Value::hash(Self) -> Int32
pub fn &Value::hash_combine(Self, Hasher) -> Unit
pub fn &Value::not_equal(Self, Self) -> Bool
pub impl Eq for &Value
pub impl Hash for &Value
