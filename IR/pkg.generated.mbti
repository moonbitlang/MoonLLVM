// Type aliases

// Traits
pub trait AbstractType : Type {
  fn asAbstractTypeEnum(Self) -> AbstractTypeEnum
}

pub trait AggregateType : Type {
  fn asAggregateTypeEnum(Self) -> AggregateTypeEnum
  fn getIndexedType(Self, ArrayView[Int32]) -> &Type?
}

pub trait Constant : Value {
  fn asConstantEnum(Self) -> ConstantEnum
}

pub trait FPType : PrimitiveType {
  fn asFPTypeEnum(Self) -> FPTypeEnum
  fn getFPMantissaWidth(Self) -> Int32
}

pub trait Floating : Show {
  fn asEnum(Self) -> FloatingEnum
  fn to_float64(Self) -> Double
}
pub impl Floating for Float
pub impl Floating for Double

pub trait GlobalValue : Value {
  fn getGlobalValueBase(Self) -> GlobalValueBase
  fn asGlobalValueEnum(Self) -> GlobalValueEnum
  fn getModule(Self) -> Module
  fn getLinkage(Self) -> Linkage
  fn setLinkage(Self, Linkage) -> Unit
  fn setUnnamedAddr(Self, UnnamedAddr) -> Unit
}

trait InsertPoint
pub impl InsertPoint for &Instruction

pub trait Instruction : Value {
  fn getInstBase(Self) -> InstBase
  fn asInstEnum(Self) -> InstEnum
  fn getParent(Self) -> Function
  fn getModule(Self) -> Module
  fn getBasicBlock(Self) -> BasicBlock?
  fn getInstName(Self) -> String?
  fn isIndependent(Self) -> Bool
  fn isTerminator(Self) -> Bool
  fn next(Self) -> &Instruction?
  fn prev(Self) -> &Instruction?
  fn insertAfter(Self, &Instruction) -> Unit raise LLVMValueError
  fn insertBefore(Self, &Instruction) -> Unit raise LLVMValueError
  fn moveBefore(Self, &Instruction) -> Unit
  fn moveAfter(Self, &Instruction) -> Unit
  fn removeFromParent(Self) -> Unit
  fn eraseFromParent(Self) -> Unit
}

